# syntax=docker/dockerfile:1

FROM claude-code:rust

LABEL org.opencontainers.image.source="https://gitea.local.wolfbox.dev/gwolf/claude-oci"
LABEL org.opencontainers.image.authors="tgwolf@salishseawolf.com"
LABEL org.opencontainers.image.description="Claude Code CLI with Rust/Cargo/WASM development environment"

# Install WebAssembly and development server tools
RUN cargo install --locked wasm-pack basic-http-server && \
    rm -rf /root/.cargo/registry /root/.cargo/git

# Copy Claude Code agents for this image
RUN mkdir -p /root/.claude/commands
COPY agents/webserver.md /root/.claude/commands/

# Entrypoint is inherited from base image
# ENTRYPOINT ["claude"]
